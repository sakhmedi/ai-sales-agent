# Copy to .env and fill in real values. Never commit .env.

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (more effort = deeper reasoning, more tokens)
ANTHROPIC_EFFORT=medium

# Agent
AGENT_MAX_STEPS=10
ICP_PATH=config/icp.yaml
FETCH_MAX_CHARS=8000
HTTP_TIMEOUT_SECONDS=10

# HubSpot private app token
HUBSPOT_TOKEN=

# SMTP for sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Safety switch: when true, no emails are sent and nothing is written to the CRM
DRY_RUN=true

DATABASE_URL=sqlite:///data/app.db
LOG_LEVEL=INFO
