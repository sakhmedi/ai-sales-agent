# Copy to .env and fill in real values. Never commit .env.

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# HubSpot private app token
HUBSPOT_TOKEN=

# SMTP for sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Safety switch: when true, no emails are sent and nothing is written to the CRM
DRY_RUN=true

DATABASE_URL=sqlite:///data/app.db
LOG_LEVEL=INFO
